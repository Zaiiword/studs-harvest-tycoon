--!strict
local TestKit = require("../TestKit")
local RetentionConfig = require("../../src/shared/config/RetentionConfig")
local Profile = require("../../src/shared/domain/Profile")
local Retention = require("../../src/shared/domain/Retention")
local describe, it, expect = TestKit.describe, TestKit.it, TestKit.expect

local DAY = 20_000

describe("Connexion quotidienne (A61)", function()
	it("propose le jour 1 à un nouveau joueur", function()
		local status = Retention.loginStatus(Retention.newState(), DAY)
		expect(status.index).toBe(1)
		expect(status.isClaimable).toBe(true)
	end)
	it("ne donne la récompense qu'une fois par jour", function()
		local state = Retention.newState()
		expect(Retention.claimLogin(state, DAY)).toBe(RetentionConfig.LOGIN_REWARDS[1])
		expect(Retention.claimLogin(state, DAY)).toBe(nil)
		expect(Retention.loginStatus(state, DAY).isClaimable).toBe(false)
	end)
	it("fait avancer la série un jour après l'autre", function()
		local state = Retention.newState()
		Retention.claimLogin(state, DAY)
		expect(Retention.claimLogin(state, DAY + 1)).toBe(RetentionConfig.LOGIN_REWARDS[2])
		expect(state.login.streak).toBe(2)
	end)
	it("repart au jour 1 après un jour manqué", function()
		local state = Retention.newState()
		Retention.claimLogin(state, DAY)
		Retention.claimLogin(state, DAY + 1)
		expect(Retention.claimLogin(state, DAY + 3)).toBe(RetentionConfig.LOGIN_REWARDS[1])
		expect(state.login.streak).toBe(1)
	end)
	it("recommence le cycle après le jour 7", function()
		local state = Retention.newState()
		for offset = 0, 6 do
			Retention.claimLogin(state, DAY + offset)
		end
		expect(Retention.loginStatus(state, DAY + 7).index).toBe(1)
		expect(Retention.loginStatus(state, DAY + 7).streak).toBe(8)
	end)
	it("survit à la sauvegarde", function()
		local state = Retention.newState()
		Retention.claimLogin(state, DAY)
		local restored = Profile.sanitize({ retention = state }).retention
		expect(restored.login.lastDay).toBe(DAY)
		expect(restored.login.streak).toBe(1)
	end)
end)

describe("Codes (A62)", function()
	it("accepte un code connu, sans tenir compte de la casse ni des espaces", function()
		local state = Retention.newState()
		local reward, result = Retention.redeemCode(state, "  bien venue ", 0)
		expect(result).toBe("ok")
		expect(reward ~= nil).toBe(true)
	end)
	it("refuse un code inconnu ou farfelu", function()
		local state = Retention.newState()
		expect(select(2, Retention.redeemCode(state, "NOPE", 0))).toBe("invalid")
		expect(select(2, Retention.redeemCode(state, 42, 0))).toBe("invalid")
		expect(select(2, Retention.redeemCode(state, string.rep("A", 500), 0))).toBe("invalid")
		expect(select(2, Retention.redeemCode(state, "LE GO!", 0))).toBe("invalid")
	end)
	it("ne sert qu'une fois par compte, même après sauvegarde", function()
		local state = Retention.newState()
		Retention.redeemCode(state, "LEGO", 0)
		expect(select(2, Retention.redeemCode(state, "lego", 0))).toBe("used")
		local restored = Profile.sanitize({ retention = state }).retention
		expect(select(2, Retention.redeemCode(restored, "LEGO", 0))).toBe("used")
	end)
	it("oublie à la sauvegarde un code qui n'existe plus", function()
		local restored = Profile.sanitize({ retention = { codes = { ANCIEN = true, LEGO = true } } }).retention
		expect(restored.codes.ANCIEN).toBe(nil)
		expect(restored.codes.LEGO).toBe(true)
	end)
	it("a des codes uniques et lisibles", function()
		local seen = {}
		for _, code in RetentionConfig.CODES do
			expect(Retention.normalizeCode(code.code)).toBe(code.code)
			expect(seen[code.code]).toBe(nil)
			seen[code.code] = true
		end
	end)
end)
