--!strict
local TestKit = require("../TestKit")
local TycoonConfig = require("../../src/shared/config/TycoonConfig")
local VehicleConfig = require("../../src/shared/config/VehicleConfig")
local Tycoon = require("../../src/shared/domain/Tycoon")
local Bag = require("../../src/shared/domain/Bag")
local MapGeometry = require("../../src/shared/domain/MapGeometry")
local Format = require("../../src/shared/util/Format")
local DevCommands = require("../../src/shared/net/DevCommands")
local describe, it, expect = TestKit.describe, TestKit.it, TestKit.expect

local NO_BONUS = Tycoon.NO_BONUS

describe("Tycoon", function()
	describe("silo", function()
		it("accepte une valeur brute jusqu'à sa capacité (A5, A16)", function()
			local state = Tycoon.new()
			expect(Tycoon.deposit(state, 100)).toBe(100)
			state.silo = TycoonConfig.SILO_CAPACITY - 10
			expect(Tycoon.deposit(state, 100)).toBe(10)
		end)
	end)

	describe("tick", function()
		it("ne rapporte rien quand le silo est vide (CDC §8)", function()
			local state = Tycoon.new()
			expect(Tycoon.tick(state, 1, NO_BONUS)).toBe(0)
			expect(Tycoon.incomePerSecond(state, NO_BONUS)).toBe(0)
		end)
		it("convertit le débit du tapis en argent", function()
			local state = Tycoon.new()
			Tycoon.deposit(state, 100)
			expect(Tycoon.tick(state, 1, NO_BONUS)).toBe(TycoonConfig.CONVEYOR.BASE_RATE)
			expect(state.silo).toBe(100 - TycoonConfig.CONVEYOR.BASE_RATE)
			expect(state.money).toBe(TycoonConfig.CONVEYOR.BASE_RATE)
		end)
		it("ne consomme pas plus que le silo ne contient", function()
			local state = Tycoon.new()
			Tycoon.deposit(state, 1)
			expect(Tycoon.tick(state, 1, NO_BONUS)).toBe(1)
			expect(state.silo).toBe(0)
		end)
		it("multiplie les machines entre elles (A6 : ×1,5 × ×3 × ×8 = ×36)", function()
			local state = Tycoon.new()
			state.machines = { Mill = true, Oven = true, Factory = true }
			expect(Tycoon.machineMultiplier(state)).toBe(36)
			Tycoon.deposit(state, 100)
			expect(Tycoon.tick(state, 1, NO_BONUS)).toBe(36 * TycoonConfig.CONVEYOR.BASE_RATE)
		end)
		it("applique le bonus Rebirth (+50 % par Rebirth)", function()
			local state = Tycoon.new()
			Tycoon.deposit(state, 100)
			local bonus = { petBonuses = {}, rebirths = 2, hasIncomeX2 = false }
			expect(Tycoon.tick(state, 1, bonus)).toBe(2 * TycoonConfig.CONVEYOR.BASE_RATE)
		end)
		it("donne l'autonomie du silo au débit actuel (CDC §10)", function()
			local state = Tycoon.new()
			Tycoon.deposit(state, 20)
			expect(Tycoon.autonomySeconds(state)).toBe(20 / TycoonConfig.CONVEYOR.BASE_RATE)
		end)
	end)

	describe("achats", function()
		it("refuse un achat sans les moyens", function()
			local state = Tycoon.new()
			expect(Tycoon.buy(state, "Mill", 1).isPurchased).toBe(false)
			expect(state.money).toBe(0)
		end)
		it("achète une machine une seule fois", function()
			local state = Tycoon.new()
			state.money = 1000
			expect(Tycoon.buy(state, "Mill", 1).isPurchased).toBe(true)
			expect(state.money).toBe(750)
			expect(Tycoon.offer(state, "Mill", 1).price).toBe(nil)
			expect(Tycoon.buy(state, "Mill", 1).isPurchased).toBe(false)
		end)
		it("augmente le prix du tapis selon Base × 1,35^n (CDC §8)", function()
			local state = Tycoon.new()
			state.money = 1_000_000
			expect(Tycoon.offer(state, "Conveyor", 1).price).toBe(50)
			Tycoon.buy(state, "Conveyor", 1)
			expect(Tycoon.offer(state, "Conveyor", 1).price).toBe(68)
			expect(Tycoon.conveyorRate(state)).toBe(TycoonConfig.CONVEYOR.BASE_RATE * TycoonConfig.CONVEYOR.RATE_GROWTH)
		end)
		it("vend le palier suivant au Garage, au prix du CDC §5", function()
			local state = Tycoon.new()
			state.money = 200
			expect(Tycoon.offer(state, "Garage", 1).price).toBe(150)
			local result = Tycoon.buy(state, "Garage", 1)
			expect(result.newTier).toBe(2)
			expect(state.money).toBe(50)
		end)
		it("n'a plus rien à vendre au Garage au palier maximal", function()
			expect(Tycoon.offer(Tycoon.new(), "Garage", #VehicleConfig.TIERS).price).toBe(nil)
		end)
	end)
end)

describe("Bag.withdraw", function()
	it("ne retire que ce que le silo peut accepter", function()
		local bag = Bag.new(10)
		for _ = 1, 10 do
			Bag.add(bag, 25)
		end
		local count, value = Bag.withdraw(bag, 100)
		expect(value).toBe(100)
		expect(count).toBe(4)
		expect(bag.count).toBe(6)
		expect(bag.value).toBe(150)
	end)
end)

describe("Repère local d'une base", function()
	it("fait l'aller-retour monde ↔ base", function()
		local base = MapGeometry.baseCenters()[3]
		local x, z = MapGeometry.baseToWorld(base, 12, -7)
		local localX, localZ = MapGeometry.worldToBase(base, x, z)
		expect(localX).toBeCloseTo(12)
		expect(localZ).toBeCloseTo(-7)
	end)
	it("place la grille de déchargement côté champ, sur la base", function()
		local pad = TycoonConfig.LAYOUT.UNLOAD_PAD
		local base = MapGeometry.baseCenters()[1]
		local x, z = MapGeometry.baseToWorld(base, pad.x, pad.z)
		expect(MapGeometry.isInsideBase(base, x, z)).toBe(true)
		expect(x > base.x).toBe(true)
	end)
end)

describe("Format", function()
	it("abrège les grands montants à la française (CDC §10)", function()
		expect(Format.money(999)).toBe("999")
		expect(Format.money(14_500)).toBe("14,5 K")
		expect(Format.money(2_000_000)).toBe("2 M")
	end)
	it("affiche une durée en minutes et secondes", function()
		expect(Format.duration(125)).toBe("2:05")
		expect(Format.duration(3725)).toBe("1:02:05")
	end)
end)

describe("DevCommands", function()
	it("accepte un palier valide", function()
		local command = DevCommands.parse("tier", 4) :: any
		expect(command.tier).toBe(4)
	end)
	it("refuse un palier hors bornes ou non entier", function()
		expect(DevCommands.parse("tier", 9)).toBe(nil)
		expect(DevCommands.parse("tier", 2.5)).toBe(nil)
		expect(DevCommands.parse("tier", "4")).toBe(nil)
		expect(DevCommands.parse("hack", 1)).toBe(nil)
	end)
end)
