--!strict
local TestKit = require("../TestKit")
local PetConfig = require("../../src/shared/config/PetConfig")
local Pets = require("../../src/shared/domain/Pets")
local PetRequests = require("../../src/shared/net/PetRequests")
local describe, it, expect = TestKit.describe, TestKit.it, TestKit.expect

describe("Index et équipement des Pets (A66)", function()
	it("compte chaque espèce dans chaque variante", function()
		expect(#Pets.indexKeys()).toBe(#PetConfig.SPECIES * #PetConfig.VARIANTS)
	end)
	it("a au moins deux espèces par rareté", function()
		for _, rarity in PetConfig.RARITIES do
			local count = 0
			for _, species in PetConfig.SPECIES do
				count += if species.rarity == rarity.id then 1 else 0
			end
			expect(count >= 2).toBe(true)
		end
	end)
	it("découvre un Pet à sa première obtention, une seule fois", function()
		local collection = Pets.newCollection()
		expect(Pets.discover(collection, "Pig:Normal")).toBe(true)
		expect(Pets.discover(collection, "Pig:Normal")).toBe(false)
		expect(Pets.discover(collection, "Nope:Normal")).toBe(false)
	end)
	it("découvre aussi les Pets obtenus par fusion", function()
		local collection = Pets.newCollection()
		for _ = 1, PetConfig.FUSION_COUNT do
			Pets.add(collection, "Bee:Normal")
		end
		Pets.fuse(collection, "Bee:Normal")
		expect(collection.discovered["Bee:Gold"]).toBe(true)
	end)
	it("paie l'index selon la rareté et la variante", function()
		expect(Pets.indexGems("Chick:Normal")).toBe(PetConfig.INDEX_GEMS.Common)
		expect(Pets.indexGems("Golem:Rainbow")).toBe(PetConfig.INDEX_GEMS.Mythic * 5)
	end)
	it("garde l'index à la sauvegarde et y ajoute les Pets possédés (anciens profils)", function()
		local collection = Pets.sanitize({ owned = { ["Cow:Normal"] = 2 }, discovered = { ["Pig:Gold"] = true } })
		expect(collection.discovered["Cow:Normal"]).toBe(true)
		expect(collection.discovered["Pig:Gold"]).toBe(true)
		local text = Pets.encodeDiscovered(collection.discovered)
		expect(Pets.decodeDiscovered(text)["Pig:Gold"]).toBe(true)
	end)
	it("équipe les meilleurs Pets, exemplaires compris", function()
		local collection = Pets.newCollection()
		Pets.add(collection, "Chick:Normal")
		Pets.add(collection, "Dragon:Normal")
		Pets.add(collection, "Cow:Normal")
		Pets.add(collection, "Cow:Normal")
		Pets.equip(collection, "Chick:Normal")
		Pets.equipBest(collection)
		expect(#collection.equipped).toBe(PetConfig.MAX_EQUIPPED)
		expect(collection.equipped[1]).toBe("Dragon:Normal")
		expect(collection.equipped[2]).toBe("Cow:Normal")
		expect(collection.equipped[3]).toBe("Cow:Normal")
	end)
	it("accepte la requête « Équiper les meilleurs » sans clé", function()
		local action = PetRequests.parseAction("best", nil)
		expect(action).toBe("best")
		expect((PetRequests.parseAction("steal", "Cow:Normal"))).toBe(nil)
	end)
end)
